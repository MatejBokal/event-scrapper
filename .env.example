# Copy to .env and fill in values. Never commit .env.

# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: publishable key for a future frontend (Dashboard → API → anon / publishable)
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Direct Postgres connection (Dashboard → Project Settings → Database)
# Session pooler (IPv4-friendly): port 5432
# Transaction pooler: port 6543
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Or set password separately if your code builds the URL:
# SUPABASE_DB_PASSWORD=your-database-password

# Optional: FastAPI server (default 8001)
# API_PORT=8001

# Phase 8 — LLM extraction (Perplexity Sonar API)
# Get a key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key
# PERPLEXITY_MODEL=sonar
# Max Perplexity calls per crawled site (contact/organizer pages scored first)
# LLM_MAX_PAGES_PER_SITE=3
# Set to true once LLM extraction is wired (Phase 8)
EXTRACTION_USE_LLM=true
